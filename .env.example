# Client ID from https://developer.spotify.com/dashboard (no client secret needed, login uses PKCE)
SPOTIFY_CLIENT_ID=
# Optional: set to use the client-secret login flow instead of PKCE. Never commit it
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI in your Spotify app settings. Spotify rejects "localhost", use 127.0.0.1
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
# Where your local database lives (git-ignored)
DB_PATH=data/spotify-sort.db
